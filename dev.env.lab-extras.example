# Lab extras keys for a 1C *project* `.dev.env`.
# Append only missing keys after /init extras Yes (or later-enable).
# Do NOT add these to the ai_rules_1c `.dev.env.example`.
# Secrets stay in the project `.dev.env` only.

# Vanessa Automation MCP (opt-in fragment mcp.optional/vanessa.json).
# Empty until the user gives host:port from «Управление MCP».
VANESSA_MCP_URL=

# MCP Toolkit HTTP (not an MCP server). Defaults if the user left blank after KD Yes.
MCP_TOOLKIT_PORT=6003
KD2_PORT=7003
KD31_PORT=6011
