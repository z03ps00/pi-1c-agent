{
  "name": "pi-1c-agent",
  "version": "0.7.0",
  "private": true,
  "description": "Multi-agent 1C:Enterprise package for vanilla Pi with PLAN/BUILD, Configuration Knowledge Layer, and detailed project initialization wizard",
  "keywords": [
    "pi-package",
    "1c",
    "bsl",
    "subagents",
    "openspec",
    "sdd"
  ],
  "pi": {
    "extensions": [
      "extensions/1c-mode/index.ts",
      "extensions/1c-subagents/index.ts",
      "extensions/1c-admin/index.ts",
      "extensions/1c-knowledge/index.ts",
      "extensions/1c-init/index.ts",
      "extensions/1c-session-rotate/index.ts",
      "extensions/1c-memory/index.ts"
    ],
    "skills": [
      "skills"
    ],
    "prompts": [
      "prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-agent-core": ">=0.85.0 <0.86.0",
    "typebox": ">=0.32.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.85.0 <0.86.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:stress": "PI_1C_STRESS=1 node tests/run-stress.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "doctor:package": "node tools/doctor.mjs --package-only",
    "scan:public": "node ../../scripts/scan-public-tree.mjs"
  }
}
