# Non-secret defaults for the portable OpenViking + Cognee stack.
# Copied into a gitignored local .env by scripts/memory-stack.sh.
# API keys live only in secrets/*.env (never commit those).

COMPOSE_PROJECT_NAME=pi-1c-memory

# Pinned images (digest). Tag fallbacks are documented for arch/registry misses.
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking@sha256:49e20c09ec7ea2f16c116d9ddb2ea90b4c24bf3f5a83078609e52399487dbec1
OPENVIKING_IMAGE_TAG_FALLBACK=ghcr.io/volcengine/openviking:latest
COGNEE_IMAGE=cognee/cognee-mcp@sha256:ae7c1ade4c2b304264eb5d031022a0e18ec0671c4fc37f66f6594b7a91edfc0c
COGNEE_IMAGE_TAG_FALLBACK=cognee/cognee-mcp:main
OLLAMA_IMAGE=ollama/ollama:latest

MEMORY_OPENVIKING_HOST=127.0.0.1
MEMORY_OPENVIKING_PORT=1933
MEMORY_COGNEE_HOST=127.0.0.1
MEMORY_COGNEE_PORT=8001
MEMORY_OLLAMA_HOST=127.0.0.1
MEMORY_OLLAMA_PORT=11434

# Router AI (default provider)
ROUTERAI_ENDPOINT=https://routerai.ru/api/v1
ROUTERAI_MODEL=qwen/qwen3.5-9b
ROUTERAI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024

# Ollama alternative (both servers). bge-m3 default dim is 1024 — same as Router AI
# embeddings, but switching providers still needs a reindex of existing vectors.
OLLAMA_INTERNAL_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen3.5:9b
OLLAMA_VLM_MODEL=ollama/qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_EMBEDDING_DIMENSIONS=1024

COGNEE_DATASET=main_dataset
