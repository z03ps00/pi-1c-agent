# ============================================================
# Pi 1C agent profile (PI_CODING_AGENT_DIR) — repository rules
# Secrets, machine state and runtimes are NEVER committed.
# ============================================================

# --- Secrets / credentials (local only) ---
auth.json
trust.json
.dev.env
.env
.env.*
!.env.example
mcp.optional/memory-stack/.env
mcp.optional/memory-stack/data/
mcp.optional/memory-stack/secrets/*.env
!mcp.optional/memory-stack/secrets/*.env.example
*.pem
*.key
id_rsa
id_ed25519

# --- Runtime runtimes / binaries (installed per machine) ---
node/
npm/
bin/
# packages/pi-1c-agent is the shipped Pi extension package — keep it tracked.

# --- Caches & generated state ---
mcp-cache.json
mcp-onboarding.json
cursor-sdk-model-list.json
models.db
models.db-shm
models.db-wal

# --- Bootstrap state with absolute machine paths (regenerated) ---
1c/

# --- Third-party upstream snapshot (public clone) ---
# git clone https://github.com/comol/ai_rules_1c.git pi-1c-agent-upstream
pi-1c-agent-upstream/

# --- Closed third-party 1C agent bundles (local reference only; never publish) ---
external-agent-sources/

# --- Pi session/bootstrap state ---
.pi/**

# --- Development-process artifacts (local only; not published) ---
openspec/changes/
handoffs/
state/evolution/**
!state/evolution/.gitkeep
state/agent-memory/pending/**
!state/agent-memory/pending/.gitkeep
state/agent-memory/processing/**
state/agent-memory/failed/**
state/agent-memory/done/**
!state/agent-memory/done/.gitkeep
state/agent-memory/worker.lock
state/agent-memory/worker.log
.cursor/plans/
.cursor/commands/opsx-*
.cursor/skills/openspec-*/
.pi/prompts/opsx-*
.pi/skills/openspec-*/

# --- Misc ---
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# --- Profile test runner artifacts (mkdtemp uses os.tmpdir; local fallbacks) ---
tests/.tmp/
tests/.artifacts/

# --- Generated client profile archives (never commit) ---
dist/

